// Realizar un algoritmo en pseudocodigo para convertir
// grados Celsius a grados Kelvin y Fahrenheit.
Algoritmo Grados
	Definir gradosCelsius Como Real
	Definir gradosKelvin, gradosFahrenheit Como Real
	Escribir 'Ingrese grados Celsius: '
	Leer gradosCelsius
	gradosKelvin <- gradosCelsius+273.15
	gradosFahrenheit <- (gradosCelsius*1.8)+32
	Escribir 'Grados Kelvin: ', gradosKelvin
	Escribir 'Grados Fahrenheit: ', gradosFahrenheit
FinAlgoritmo
