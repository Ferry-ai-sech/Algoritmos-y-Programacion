// Una persona invierte su capital en un banco y desea saber cuánto dinero
// ganará después de un mes si la entidad paga a razón del 2  MOD  mensual.
Algoritmo InversionBanco
	Definir capital, ganancia Como Real
	Escribir 'Ingresa el capital a invertir: '
	Leer capital
	ganancia <- capital*0.02
	Escribir 'La ganancia después de un mes es: ', ganancia
FinAlgoritmo
